{
  "repo": "ion-chain-gas-flow",
  "language": "C",
  "category": "Blockchain tooling",
  "goal": "Implement a C blockchain tooling project for gas constraint solving, using bounded scenario files and conflict explanations.",
  "weights": {
    "signal": 2,
    "slack": 2,
    "confidence": 1,
    "drag": 5
  },
  "thresholds": {
    "ship": 157,
    "watch": 118
  },
  "properties": [
    "raising signal cannot reduce score",
    "raising drag cannot improve score",
    "lane labels must match configured thresholds",
    "golden fixture ids must remain unique"
  ],
  "fixture_files": [
    "fixtures/golden/scoreboard.csv",
    "fixtures/golden/lane-matrix.csv",
    "fixtures/fuzz/mutations.csv",
    "fixtures/fuzz/boundary-cases.jsonl"
  ]
}
